{
    "name": "afiphp/afiphp",
    "type": "library",
    "description": "Cliente PHP para los Web Services de ARCA (ex AFIP)",
    "keywords": ["arca", "afip", "wsaa", "wsfe"],
    "homepage": "https://github.com/afiphp/afiphp",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-soap": "*"
    },
    "authors": [
        {
            "name": "Claudio Escobar",
            "email": "claudioe0407@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Afiphp\\": "src"
        }
    },
    "require-dev": {
        "carthage-software/mago": "^1.61",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "format": "mago fmt",
        "format:check": "mago fmt --check",
        "test": "phpunit",
        "test:arca": "phpunit --group arca",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
